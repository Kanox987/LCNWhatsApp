# syntax=docker/dockerfile:1
# Variante COM transcrição local (faster-whisper). Mais pesada — use só se for
# ligar a transcrição no provedor "faster-whisper". Para a maioria, o Dockerfile
# base já basta.
FROM node:20-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg git ca-certificates python3 python3-pip python3-venv build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm npm install --omit=dev --no-audit --no-fund

# venv isolado com faster-whisper. --mount=type=cache persiste o cache do pip
# entre builds — uma edição em package.json não deveria custar recompilar isso
# também, mas se o cache do pip já tiver as wheels, é rápido de qualquer jeito.
RUN --mount=type=cache,target=/root/.cache/pip python3 -m venv /opt/whisper && \
    /opt/whisper/bin/pip install faster-whisper
ENV LCN_PYTHON=/opt/whisper/bin/python

# Modelo baixado num volume persistente (montado pelo run.sh/compose), não
# durante o build — senão todo rebuild/update baixaria de novo.
ENV LCN_WHISPER_MODELS_DIR=/opt/lcn-modelos

COPY . .

VOLUME ["/app/sessao", "/app/midia", "/app/data", "/opt/lcn-modelos"]
ENV NODE_ENV=production
CMD ["node", "index.js"]

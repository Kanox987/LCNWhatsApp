# syntax=docker/dockerfile:1
# Variante COM transcrição local (faster-whisper). Mais pesada — use só se for
# ligar a transcrição no provedor "faster-whisper". Para a maioria, o Dockerfile
# base já basta.
# node:22 (não 20): zapo-js precisa de WebSocket global do runtime, estável só
# a partir do Node 22.
FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg git ca-certificates python3 python3-pip python3-venv build-essential util-linux \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm npm install --omit=dev --no-audit --no-fund

# venv isolado com faster-whisper. --mount=type=cache persiste o cache do pip
# entre builds — uma edição em package.json não deveria custar recompilar isso
# também, mas se o cache do pip já tiver as wheels, é rápido de qualquer jeito.
RUN --mount=type=cache,target=/root/.cache/pip python3 -m venv /opt/whisper && \
    /opt/whisper/bin/pip install faster-whisper
ENV LCN_PYTHON=/opt/whisper/bin/python

# Modelo baixado num volume persistente (montado pelo run.sh/compose), não
# durante o build — senão todo rebuild/update baixaria de novo.
ENV LCN_WHISPER_MODELS_DIR=/opt/lcn-modelos

COPY . .

RUN chmod +x /app/bin/lcn-container.sh /app/bin/lock-and-run.sh /app/bin/lcn

# Mesma razão do Dockerfile base: o banco do motor mora em
# $HOME/.local/share/lcnwhatsapp, e sem HOME fixo isso cairia em /root, fora de
# qualquer volume.
VOLUME ["/app/sessao", "/app/midia", "/app/data", "/opt/lcn-modelos", "/home/node/.local/share/lcnwhatsapp"]
ENV NODE_ENV=production
ENV HOME=/home/node
RUN mkdir -p /home/node/.local/share/lcnwhatsapp

# Sobe motor + painel + gateway, como o Dockerfile base. O comando anterior
# subia só o gateway: sem motor ele recebe mensagem, não decide nada e fica
# mudo no WhatsApp sem erro visível.
CMD ["/app/bin/lcn-container.sh"]

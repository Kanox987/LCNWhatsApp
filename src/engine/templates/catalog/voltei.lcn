template voltei v1
  nome: Voltei da ausência
  descrição: Limpa o status de ausência e o recado guardado anteriormente pelo contato, indicando que a pessoa já está disponível novamente.
  categoria: utilitarios

automação
  nome: Voltei da ausência
  tipo: comando
  dispara com: {{params.command}}
  menu: {{params.command}} — Desativa o status de ausência e limpa o recado
  pool: {{params.poolId}}
  acessa: texto
  casa: exato
  quem: {{params.allowFrom}}
  acesso: {{params.acesso}}

  define sender ausente = ""
  define sender recado = ""
  responde "{{params.confirmacao}}"

configurável
  command: texto = "/voltei"
    rótulo: Comando
    ajuda: A palavra digitada para desativar o status de ausência.
  confirmacao: texto = "Você está de volta! O status de ausência foi removido."
    rótulo: Mensagem de confirmação
    ajuda: Resposta enviada confirmando que o aviso de ausência foi desativado.
  allowFrom: opção (external, any) = "external"
    rótulo: Quem pode acionar
    ajuda: any responde também às mensagens do próprio número do bot; external restringe a outras pessoas.
  poolId: texto
    rótulo: Pool que responde
    ajuda: Identificador do pool de números que vai executar este comando.
  acesso: texto = "todos"
    rótulo: Quem pode usar
    ajuda: todos, dono, admins (administradores do grupo) ou lista <nome> (quem foi posto nessa lista). O dono sempre pode. Quem não pode é ignorado, sem resposta.

declara
  sender ausente: texto
    Marca se o contato está ausente ("sim" ou vazio).
  sender recado: texto
    O recado deixado pelo contato ao marcar ausência.

# nós: gatilho, limpar-ausente, limpar-recado, confirmar

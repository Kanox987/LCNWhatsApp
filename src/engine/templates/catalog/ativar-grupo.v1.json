{
  "templateId": "ativar-grupo",
  "templateVersion": 1,
  "name": "Ativar o bot neste grupo",
  "description": "Autoriza o bot a agir NESTE grupo, alternando a cada uso. Sem isso, em grupo o bot fica inerte: nenhuma automação é avaliada e nada é registrado — só comandos restritos ao dono passam, que é como este aqui consegue funcionar. Em conversa direta não é preciso: lá quem escreveu escolheu falar com o bot.",
  "category": "configuracoes",
  "dependsOn": [],
  "requiredCapabilities": [],
  "variables": [
    {
      "scope": "chat",
      "key": "grupo_ativo",
      "valueType": "text",
      "description": "Marca deste grupo. Preenchida = o dono autorizou o bot a agir aqui."
    }
  ],
  "warnings": [
    {
      "level": "info",
      "text": "Restrito ao dono. Vale só para o grupo onde o comando for usado."
    },
    {
      "level": "info",
      "text": "Desativar não apaga nada: o bot volta a ficar inerte no grupo, e as automações continuam publicadas para os outros lugares."
    }
  ],
  "parameters": [
    {
      "key": "command",
      "label": "Comando",
      "type": "string",
      "default": "/ativar",
      "help": "Comando que o dono usa dentro do grupo para ligar e desligar o bot ali."
    },
    {
      "key": "ligadoText",
      "label": "Resposta ao ligar",
      "type": "string",
      "default": "✅ Bot ATIVADO neste grupo.\nAgora os comandos funcionam aqui. Use o mesmo comando para desativar.",
      "help": "Resposta quando o comando liga."
    },
    {
      "key": "desligadoText",
      "label": "Resposta ao desligar",
      "type": "string",
      "default": "🚫 Bot DESATIVADO neste grupo.\nParei de avaliar as mensagens daqui. Use o mesmo comando para ativar de novo.",
      "help": "Resposta quando o comando desliga."
    },
    {
      "key": "poolId",
      "label": "Pool que responde",
      "type": "string",
      "help": "Identificador do pool de números que vai executar este comando."
    }
  ],
  "documentTemplate": {
    "schemaVersion": 1,
    "enabled": true,
    "name": "Interruptor da recuperação automática",
    "display": {
      "menuLabel": "{{params.command}}",
      "menuDescription": "Liga/desliga a recuperação automática aqui"
    },
    "scope": {
      "include": [],
      "exclude": []
    },
    "inputPolicy": {
      "acceptedMessageKinds": [
        "text"
      ],
      "historyPolicy": "live_only"
    },
    "responder": {
      "strategy": "weighted_rendezvous",
      "poolId": "{{params.poolId}}"
    },
    "flow": {
      "nodes": [
        {
          "id": "gatilho-comando",
          "type": "trigger.command",
          "config": {
            "command": "{{params.command}}",
            "match": "exact",
            "allowFrom": "external",
            "requireOwner": true
          }
        },
        {
          "id": "esta-ligado",
          "type": "condition.compare",
          "config": {
            "operator": "eq",
            "left": {
              "source": "variable",
              "scope": "chat",
              "key": "grupo_ativo"
            },
            "right": {
              "source": "literal",
              "value": "sim"
            }
          }
        },
        {
          "id": "desligar",
          "type": "action.variable.set",
          "config": {
            "scope": "chat",
            "key": "grupo_ativo",
            "value": ""
          }
        },
        {
          "id": "avisar-desligado",
          "type": "action.whatsapp.reply",
          "config": {
            "text": "{{params.desligadoText}}"
          }
        },
        {
          "id": "ligar",
          "type": "action.variable.set",
          "config": {
            "scope": "chat",
            "key": "grupo_ativo",
            "value": "sim"
          }
        },
        {
          "id": "avisar-ligado",
          "type": "action.whatsapp.reply",
          "config": {
            "text": "{{params.ligadoText}}"
          }
        }
      ],
      "edges": [
        {
          "from": "gatilho-comando",
          "to": "esta-ligado",
          "on": "matched"
        },
        {
          "from": "esta-ligado",
          "to": "desligar",
          "on": "true"
        },
        {
          "from": "desligar",
          "to": "avisar-desligado",
          "on": "success"
        },
        {
          "from": "esta-ligado",
          "to": "ligar",
          "on": "false"
        },
        {
          "from": "ligar",
          "to": "avisar-ligado",
          "on": "success"
        }
      ]
    }
  }
}

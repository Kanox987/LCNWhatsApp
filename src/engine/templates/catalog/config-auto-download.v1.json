{
  "templateId": "config-auto-download",
  "templateVersion": 1,
  "name": "Interruptor do download automático",
  "description": "Liga e desliga o download automático NESTA conversa, alternando a cada uso e respondendo em que estado ficou. Ele só marca a conversa — quem baixa é a regra \"Baixar links automaticamente\".",
  "category": "configuracoes",
  "dependsOn": [],
  "requiredCapabilities": [],
  "variables": [
    {
      "scope": "chat",
      "key": "auto_download",
      "valueType": "text",
      "description": "Marcador desta conversa. Preenchido = download automático ligado aqui."
    }
  ],
  "warnings": [
    {
      "level": "info",
      "text": "Restrito ao dono do bot. Marca só a conversa onde o comando for usado."
    }
  ],
  "parameters": [
    {
      "key": "command",
      "label": "Comando",
      "type": "string",
      "default": "/autodow",
      "help": "Digite sozinho: cada uso inverte o estado nesta conversa."
    },
    {
      "key": "ligadoText",
      "label": "Resposta ao ligar",
      "type": "string",
      "default": "✅ Download automático LIGADO nesta conversa.\nTodo link que chegar aqui será baixado.",
      "help": "Resposta quando liga."
    },
    {
      "key": "desligadoText",
      "label": "Resposta ao desligar",
      "type": "string",
      "default": "⛔ Download automático DESLIGADO nesta conversa.",
      "help": "Resposta quando desliga."
    },
    {
      "key": "poolId",
      "label": "Pool que responde",
      "type": "string",
      "help": "Identificador do pool de números que vai executar este comando."
    }
  ],
  "documentTemplate": {
    "schemaVersion": 1,
    "enabled": true,
    "name": "Interruptor do download automático",
    "display": {
      "menuLabel": "{{params.command}}",
      "menuDescription": "Liga/desliga o download automático aqui"
    },
    "scope": {
      "include": [],
      "exclude": []
    },
    "inputPolicy": {
      "acceptedMessageKinds": [
        "text"
      ],
      "historyPolicy": "live_only"
    },
    "responder": {
      "strategy": "weighted_rendezvous",
      "poolId": "{{params.poolId}}"
    },
    "flow": {
      "nodes": [
        {
          "id": "gatilho-comando",
          "type": "trigger.command",
          "config": {
            "command": "{{params.command}}",
            "match": "exact",
            "allowFrom": "external",
            "requireOwner": true
          }
        },
        {
          "id": "esta-ligado",
          "type": "condition.compare",
          "config": {
            "operator": "eq",
            "left": {
              "source": "variable",
              "scope": "chat",
              "key": "auto_download"
            },
            "right": {
              "source": "literal",
              "value": "sim"
            }
          }
        },
        {
          "id": "desligar",
          "type": "action.variable.set",
          "config": {
            "scope": "chat",
            "key": "auto_download",
            "value": ""
          }
        },
        {
          "id": "avisar-desligado",
          "type": "action.whatsapp.reply",
          "config": {
            "text": "{{params.desligadoText}}"
          }
        },
        {
          "id": "ligar",
          "type": "action.variable.set",
          "config": {
            "scope": "chat",
            "key": "auto_download",
            "value": "sim"
          }
        },
        {
          "id": "avisar-ligado",
          "type": "action.whatsapp.reply",
          "config": {
            "text": "{{params.ligadoText}}"
          }
        }
      ],
      "edges": [
        {
          "from": "gatilho-comando",
          "to": "esta-ligado",
          "on": "matched"
        },
        {
          "from": "esta-ligado",
          "to": "desligar",
          "on": "true"
        },
        {
          "from": "desligar",
          "to": "avisar-desligado",
          "on": "success"
        },
        {
          "from": "esta-ligado",
          "to": "ligar",
          "on": "false"
        },
        {
          "from": "ligar",
          "to": "avisar-ligado",
          "on": "success"
        }
      ]
    }
  }
}

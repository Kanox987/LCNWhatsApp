{
  "templateId": "anti-imagem",
  "templateVersion": 1,
  "name": "Anti-imagem",
  "description": "Apaga automaticamente toda mensagem de imagem enviada no grupo, sem precisar de comando. Você escolhe quantos avisos a pessoa recebe antes de ser removida. O contador é por pessoa e por grupo, e o dono do bot nunca é removido.",
  "category": "modulos-especializados",
  "dependsOn": [],
  "requiredCapabilities": [],
  "variables": [
    {
      "scope": "member",
      "key": "anti-imagem_apagados",
      "valueType": "number",
      "description": "Quantas imagens desta pessoa já foram apagadas NESTE grupo."
    }
  ],
  "warnings": [
    {
      "level": "requirement",
      "text": "Para apagar mensagens e remover pessoas, o número precisa ser ADMINISTRADOR do grupo."
    }
  ],
  "parameters": [
    {
      "key": "limite",
      "label": "Avisos antes de remover",
      "type": "number",
      "default": 3,
      "help": "Use um número alto (ex: 999) se quiser só apagar e avisar, sem nunca remover ninguém."
    },
    {
      "key": "aviso",
      "label": "Texto do aviso",
      "type": "string",
      "default": "Imagens não são permitidas neste grupo.",
      "help": "Enviado toda vez que uma mensagem é apagada, antes de a pessoa atingir o limite."
    },
    {
      "key": "poolId",
      "label": "Pool que responde",
      "type": "string",
      "help": "Identificador do pool de números que executa esta regra."
    }
  ],
  "documentTemplate": {
    "schemaVersion": 1,
    "enabled": true,
    "name": "Anti-imagem",
    "scope": {
      "include": [],
      "exclude": []
    },
    "inputPolicy": {
      "acceptedMessageKinds": [
        "image"
      ],
      "historyPolicy": "live_only"
    },
    "responder": {
      "strategy": "weighted_rendezvous",
      "poolId": "{{params.poolId}}"
    },
    "flow": {
      "nodes": [
        {
          "id": "detectar",
          "type": "trigger.message",
          "config": {
            "allowFrom": "external",
            "messageKinds": [
              "image"
            ]
          }
        },
        {
          "id": "apagar",
          "type": "action.whatsapp.delete",
          "config": {}
        },
        {
          "id": "contar",
          "type": "action.variable.increment",
          "config": {
            "scope": "group_member",
            "key": "anti-imagem_apagados",
            "by": 1
          }
        },
        {
          "id": "passou",
          "type": "condition.compare",
          "config": {
            "left": {
              "source": "variable",
              "scope": "group_member",
              "key": "anti-imagem_apagados"
            },
            "operator": "gte",
            "right": {
              "source": "literal",
              "value": "{{params.limite}}"
            }
          }
        },
        {
          "id": "remover",
          "type": "action.group.remove",
          "config": {
            "who": "sender",
            "neverRemoveOwner": true
          }
        },
        {
          "id": "avisar",
          "type": "action.whatsapp.reply",
          "config": {
            "text": "{{params.aviso}}"
          }
        }
      ],
      "edges": [
        {
          "from": "detectar",
          "to": "apagar",
          "on": "matched"
        },
        {
          "from": "apagar",
          "to": "contar",
          "on": "success"
        },
        {
          "from": "contar",
          "to": "passou",
          "on": "success"
        },
        {
          "from": "passou",
          "to": "remover",
          "on": "true"
        },
        {
          "from": "passou",
          "to": "avisar",
          "on": "false"
        }
      ]
    }
  }
}

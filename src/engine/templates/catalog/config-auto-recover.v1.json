{
  "templateId": "config-auto-recover",
  "templateVersion": 1,
  "name": "Interruptor da recuperação automática",
  "description": "Liga e desliga a recuperação automática NESTA conversa, alternando a cada uso. Digite o comando e ele responde dizendo em que estado ficou. Ele só marca a conversa — quem recupera é a regra \"Recuperar automaticamente\".",
  "category": "configuracoes",
  "dependsOn": [],
  "requiredCapabilities": [],
  "variables": [
    {
      "scope": "chat",
      "key": "auto_recover",
      "valueType": "text",
      "description": "Marcador desta conversa. Preenchido = recuperação automática ligada aqui."
    }
  ],
  "warnings": [
    {
      "level": "info",
      "text": "Restrito ao dono do bot. Marca só a conversa onde o comando for usado."
    }
  ],
  "parameters": [
    {
      "key": "command",
      "label": "Comando",
      "type": "string",
      "default": "/autorecover",
      "help": "Digite o comando sozinho: cada uso inverte o estado nesta conversa."
    },
    {
      "key": "ligadoText",
      "label": "Resposta ao ligar",
      "type": "string",
      "default": "✅ Recuperação automática LIGADA nesta conversa.\nToda visualização única que chegar aqui será recuperada.",
      "help": "Resposta quando o comando liga."
    },
    {
      "key": "desligadoText",
      "label": "Resposta ao desligar",
      "type": "string",
      "default": "⛔ Recuperação automática DESLIGADA nesta conversa.",
      "help": "Resposta quando o comando desliga."
    },
    {
      "key": "poolId",
      "label": "Pool que responde",
      "type": "string",
      "help": "Identificador do pool de números que vai executar este comando."
    }
  ],
  "documentTemplate": {
    "schemaVersion": 1,
    "enabled": true,
    "name": "Interruptor da recuperação automática",
    "display": {
      "menuLabel": "{{params.command}}",
      "menuDescription": "Liga/desliga a recuperação automática aqui"
    },
    "scope": {
      "include": [],
      "exclude": []
    },
    "inputPolicy": {
      "acceptedMessageKinds": [
        "text"
      ],
      "historyPolicy": "live_only"
    },
    "responder": {
      "strategy": "weighted_rendezvous",
      "poolId": "{{params.poolId}}"
    },
    "flow": {
      "nodes": [
        {
          "id": "gatilho-comando",
          "type": "trigger.command",
          "config": {
            "command": "{{params.command}}",
            "match": "exact",
            "allowFrom": "external",
            "requireOwner": true
          }
        },
        {
          "id": "esta-ligado",
          "type": "condition.compare",
          "config": {
            "operator": "eq",
            "left": {
              "source": "variable",
              "scope": "chat",
              "key": "auto_recover"
            },
            "right": {
              "source": "literal",
              "value": "sim"
            }
          }
        },
        {
          "id": "desligar",
          "type": "action.variable.set",
          "config": {
            "scope": "chat",
            "key": "auto_recover",
            "value": ""
          }
        },
        {
          "id": "avisar-desligado",
          "type": "action.whatsapp.reply",
          "config": {
            "text": "{{params.desligadoText}}"
          }
        },
        {
          "id": "ligar",
          "type": "action.variable.set",
          "config": {
            "scope": "chat",
            "key": "auto_recover",
            "value": "sim"
          }
        },
        {
          "id": "avisar-ligado",
          "type": "action.whatsapp.reply",
          "config": {
            "text": "{{params.ligadoText}}"
          }
        }
      ],
      "edges": [
        {
          "from": "gatilho-comando",
          "to": "esta-ligado",
          "on": "matched"
        },
        {
          "from": "esta-ligado",
          "to": "desligar",
          "on": "true"
        },
        {
          "from": "desligar",
          "to": "avisar-desligado",
          "on": "success"
        },
        {
          "from": "esta-ligado",
          "to": "ligar",
          "on": "false"
        },
        {
          "from": "ligar",
          "to": "avisar-ligado",
          "on": "success"
        }
      ]
    }
  }
}

template letreiro v1
  nome: Letreiro (frase deslizando)
  descrição: Escreva "/letreiro sextou" e o bot devolve uma figurinha animada com a frase numa linha só, entrando pela direita e saindo pela esquerda — letreiro de painel luminoso. A letra ocupa metade da altura; frase comprida usa letra menor para o letreiro não passar de 6 segundos. Não precisa de mídia nenhuma.
  categoria: utilitarios

automação
  nome: Letreiro (frase deslizando)
  tipo: comando
  dispara com: {{params.command}}
  menu: {{params.command}} — Frase deslizando, como painel luminoso
  pool: {{params.poolId}}
  acessa: texto
  casa: exato ou com argumentos
  quem: {{params.allowFrom}}

  chama {{params.conexao}}.figurinha_de_frase
    com
      texto: "{{message.args}}"
      efeito: "deslizar"
      tema: {{params.tema}}
      fundo: {{params.fundo}}
      letra: {{params.letra}}
      fonte: {{params.fonte}}
      pacote: {{params.pacote}}
      autor: {{params.autor}}
    sem dados: "{{params.semTextoText}}"
    erro: "{{params.errorText}}"

configurável
  command: texto = "/letreiro"
    rótulo: Comando
    ajuda: A pessoa digita o comando e a frase na mesma linha. Até 200 caracteres.
  conexao: texto = "imagem"
    rótulo: Serviço que converte
    ajuda: O identificador da conexão, como está na aba Conexões.
  tema: opção (neon, classico, papel, alerta, noite, doce, festa) = "neon"
    rótulo: Tema de cor
    ajuda: Combinação pronta de fundo e letra. neon é preto com verde; classico é preto com branco; papel é branco com preto; alerta é amarelo com preto; noite é azul-marinho com branco; doce é rosa com branco; festa é fundo arco-íris.
  fundo: texto = ""
    rótulo: Cor do fundo
    ajuda: Deixe vazio para usar a do tema. Preenchido, ganha do tema.
  letra: texto = ""
    rótulo: Cor da letra
    ajuda: Deixe vazio para usar a do tema. Preenchido, ganha do tema.
  fonte: opção (padrao, serifa, mono, liberation, liberation-serifa, fina) = "padrao"
    rótulo: Letra
    ajuda: mono combina com cara de painel; fina fica elegante em frase curta.
  pacote: texto = "LCN Frases"
    rótulo: Nome do pacote
    ajuda: Aparece quando alguém abre a figurinha no WhatsApp.
  autor: texto = "LCN"
    rótulo: Autor do pacote
    ajuda: Aparece junto do nome do pacote.
  allowFrom: opção (external, any) = "external"
    rótulo: Quem pode acionar
    ajuda: any responde também às SUAS próprias mensagens, do número onde o bot roda.
  semTextoText: texto = "Escreve a frase junto com o comando. Exemplo: /letreiro sextou, bora pro churrasco 🍖"
    rótulo: Aviso quando vier sem frase
    ajuda: Resposta quando o comando é usado sozinho.
  errorText: texto = "Não consegui fazer o letreiro: {{erro}}"
    rótulo: Se falhar
    ajuda: Escreva {{erro}} onde quiser que apareça o motivo.
  poolId: texto
    rótulo: Pool que responde
    ajuda: Identificador do pool de números que vai executar este comando.

avisa exige
  Exige o serviço de imagem configurado na aba Conexões.

avisa nota
  Sempre animada: o letreiro é o movimento. São até 120 quadros, e o serviço desce a qualidade antes de picar os quadros, para o peso caber no limite de figurinha.

# nós: gatilho-comando, fazer-o-letreiro
